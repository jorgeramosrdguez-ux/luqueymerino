{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    { "source": "/((?!img/).*(?:textil|ropa-de-cama|sabana|toalla|albornoz|mantel|manta|edredon|nordic|colcha|cojin|plaid|alfombra|boutis).*)", "destination": "/?cat=textil", "statusCode": 301 },
    { "source": "/((?!img/).*(?:cortina|estor|panel|japones|visillo).*)", "destination": "/?cat=cortina", "statusCode": 301 },
    { "source": "/((?!img/).*(?:colchon|protector).*)", "destination": "/?cat=colchon", "statusCode": 301 },
    { "source": "/((?!img/).*(?:infantil|cuna).*)", "destination": "/?cat=infantil", "statusCode": 301 },
    { "source": "/((?!img/).*bebe.*)", "destination": "/?cat=bebe", "statusCode": 301 },
    { "source": "/((?!img/).*(?:bordad|regalo|personaliz).*)", "destination": "/?ir=bordado", "statusCode": 301 },
    { "source": "/((?!img/).*(?:quienes|nosotros|about|empresa|historia).*)", "destination": "/?ir=nosotros", "statusCode": 301 },
    { "source": "/((?!img/).*(?:contact|donde|ubicacion|localiza|horario).*)", "destination": "/?ir=visitanos", "statusCode": 301 },
    { "source": "/((?!img/).*(?:aviso-legal|politica|cookies|legal|terminos|condiciones).*)", "destination": "/privacidad", "statusCode": 301 },
    { "source": "/((?!img/).*(?:tienda|shop|producto|product|categoria|category|catalogo|complemento|decoracion|oferta).*)", "destination": "/?ir=catalogo", "statusCode": 301 }
  ]
}
